# ─── IntegraX Self-Hosted — Variables de entorno ─────────────────────────────
# Copiar a .env y completar todos los valores marcados con CAMBIAR

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=integrax
POSTGRES_PASSWORD=CAMBIAR_password_seguro
POSTGRES_DB=integrax

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CAMBIAR_redis_password

# ── Seguridad (generar con: openssl rand -hex 32) ────────────────────────────
JWT_SECRET=CAMBIAR_jwt_secret_minimo_32_caracteres
CREDENTIAL_ENCRYPTION_KEY=CAMBIAR_encryption_key_exactamente_32_chars

# ── Licencia IntegraX (provista por IntegraX al contratar) ───────────────────
INTEGRAX_LICENSE_KEY=ixl_CAMBIAR

# ── Tenant único (self-hosted = un solo tenant) ───────────────────────────────
INTEGRAX_TENANT_ID=CAMBIAR_nombre_de_tu_empresa

# ── Versión ───────────────────────────────────────────────────────────────────
INTEGRAX_VERSION=latest

# ── IA (opcional — habilita análisis de schema drift con Claude) ──────────────
ANTHROPIC_API_KEY=

# ── Notificaciones (opcional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Telemetría — solo logs y métricas de salud, NUNCA datos de negocio ────────
# Permite a IntegraX detectar errores y ayudarte proactivamente.
# Desactivar con: INTEGRAX_TELEMETRY_ENABLED=false
INTEGRAX_TELEMETRY_ENABLED=true
INTEGRAX_INGEST_URL=https://api.integrax.dev/telemetry/ingest
INTEGRAX_HEARTBEAT_URL=https://api.integrax.dev/license/heartbeat

# ── Storage (opcional — por defecto usa disco local) ─────────────────────────
# Configurar para usar Cloudflare R2 en producción
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# ── Email (opcional — habilita notificaciones por email) ─────────────────────
# Opción 1: Resend (recomendado)
RESEND_API_KEY=
EMAIL_FROM=IntegraX <noreply@tudominio.com>
# Opción 2: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── URL pública de la app (para emails de verificación) ──────────────────────
APP_URL=https://tu-dominio.com

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
