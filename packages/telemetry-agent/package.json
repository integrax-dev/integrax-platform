    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "pino": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.0"
  }
}
