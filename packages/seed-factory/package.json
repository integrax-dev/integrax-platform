{
  "name": "@integrax/seed-factory",
  "version": "0.1.0",
  "description": "Typed seed arrays and CLI seed scripts for the IntegraX Consistency Control Plane",
  "type": "module",
  "main": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "bin": {
    "integrax-seed": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "seed:all": "node --loader ts-node/esm src/cli.ts all",
    "seed:connectors": "node --loader ts-node/esm src/cli.ts connectors",
    "seed:mappings": "node --loader ts-node/esm src/cli.ts mappings",
    "seed:signals": "node --loader ts-node/esm src/cli.ts signals"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
