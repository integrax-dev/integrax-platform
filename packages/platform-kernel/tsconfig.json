{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@integrax/entities": ["../entities/src/index.ts"],
      "@integrax/entities/*": ["../entities/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
