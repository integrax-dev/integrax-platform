{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@integrax/workflow-engine": ["../../packages/workflow-engine/src/index.ts"],
      "@integrax/integration-engine": ["../../packages/integration-engine/src/index.ts"],
      "@integrax/event-bus": ["../../packages/event-bus/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
